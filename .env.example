# ============================================================================
# Dynamiq Context Engine — local dev environment template
# Copy to `.env` and fill in. The `.env` file is gitignored.
# ============================================================================

# --- Postgres (required) ---------------------------------------------------
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://memory:memory@postgres:5432/memory
POSTGRES_SYNC_URL=postgresql://memory:memory@postgres:5432/memory

# --- Redis (required, job queue) -------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Object storage / S3 (required, MinIO in dev) --------------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memoryminio
S3_SECRET_KEY=memoryminio
S3_BUCKET=memory-attachments
S3_REGION=us-east-1

# --- JWT secrets (required — generate with `openssl rand -hex 32`) ---------
# BetterAuth (web) and the FastAPI backend share JWT_SECRET so that sessions
# minted in the web flow validate as MCP tokens against the API.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=dynamiq-context-engine

# Public URL the backend is reachable on (no trailing slash). Used for OAuth
# Protected Resource Metadata and the `aud` claim on agent tokens. External
# MCP clients point at `${PUBLIC_BASE_URL}/api/mcp/rpc`.
PUBLIC_BASE_URL=http://localhost:8000

# --- Web app (required) ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# --- Backend (required) ----------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Collab / Hocuspocus (required) ----------------------------------------
COLLAB_PORT=1234
# Shared secret for Hocuspocus's internal block-tree → Yjs hydration
# endpoint. Used by the demo seeder. Generate with `openssl rand -hex 32`.
HYDRATE_SECRET=change-me-to-a-long-random-string
COLLAB_INTERNAL_URL=http://hocuspocus:1234

# --- LLM provider (required if you want extraction / playground) -----------
# LiteLLM under the hood — set the provider's API key. The playground page
# and the live_llm pytest marker use ANTHROPIC_API_KEY directly.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Playground (optional) -------------------------------------------------
# Model used by the chat-style playground. Defaults to LLM_MODEL when blank.
PLAYGROUND_MODEL=claude-sonnet-4-6

# --- MCP server (optional) -------------------------------------------------
# Per-token requests-per-minute cap on /api/mcp/* for agent tokens. Session
# JWTs are not rate-limited here.
MCP_RATE_LIMIT_RPM=60

# --- Retrieval feature flags (optional) ------------------------------------
CONTRADICTOR_SIMILARITY_THRESHOLD=0.85
HYBRID_RRF_K=60
SEARCH_DEFAULT_LIMIT=20
# Cross-encoder reranker — off by default; flip on if reranker_model is
# downloaded and runtime memory allows.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=30

# --- Worker tuning (optional) ----------------------------------------------
WORKER_DRAIN_SECONDS=30
AUDIT_LOG_RETENTION_DAYS=365

# --- Observability (optional) ----------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
