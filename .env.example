# Postgres
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://memory:memory@postgres:5432/memory
POSTGRES_SYNC_URL=postgresql://memory:memory@postgres:5432/memory

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memoryminio
S3_SECRET_KEY=memoryminio
S3_BUCKET=memory-attachments
S3_REGION=us-east-1

# JWT (BetterAuth shares this signing secret with the backend)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=dynamiq-context-engine

# Public URL the backend is reachable on (without trailing slash). Used for
# OAuth Protected Resource Metadata and JWT `aud` stamping. External MCP
# clients (Claude Code, Cursor) point at `${PUBLIC_BASE_URL}/api/mcp/rpc`.
PUBLIC_BASE_URL=http://localhost:8000

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Collab (Hocuspocus)
COLLAB_PORT=1234

# Shared secret for Hocuspocus's internal block-tree → Yjs hydration
# endpoint. Used by the demo seeder. Generate with `openssl rand -hex 32`.
HYDRATE_SECRET=change-me-to-a-long-random-string
COLLAB_INTERNAL_URL=http://hocuspocus:1234

# LLM (LiteLLM)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Feature flags
CONTRADICTOR_SIMILARITY_THRESHOLD=0.85
HYBRID_RRF_K=60
SEARCH_DEFAULT_LIMIT=20
